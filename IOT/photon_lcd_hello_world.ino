// Particle Photon (original Wi-Fi model, USB ID 2B04:C006)
// + Tayda A-1748 (1602D1 16x2 character LCD, ST7066 / HD44780-compatible)
// A dumb terminal: every few minutes (the server says how often) it fetches GET /lcd from the LAN server, which returns the
// exact 32 bytes to show (line 1 = bytes 0-15, line 2 = 16-31). The server decides the layout;
// today that's percent LEFT for Claude Code, OpenAI, GitHub Copilot and ElevenLabs.
// This firmware only owns the 4 custom glyphs (shown at codes 0x08-0x0B), the stale marker, the
// refresh indicator, and the roll: a percentage that changed counts up or down to its new value.
//
// The LCD runs in 4-bit mode, write-only. R/W (LCD pin 5) is tied to GND so the LCD never
// drives the data lines; the Photon only ever sends 3.3V signals to it.
//
// Wiring (LCD pin -> Photon pin):
//    1 VSS  -> GND
//    2 VDD  -> VIN (about 4.8V out when the Photon is powered from USB)
//    3 V0   -> GND (full contrast; a pot wiper between VIN and GND also works)
//    4 RS   -> D2
//    5 R/W  -> GND
//    6 E    -> D3
//    7-10 DB0-DB3 -> not connected (unused in 4-bit mode)
//   11 DB4  -> D4
//   12 DB5  -> D5
//   13 DB6  -> D6
//   14 DB7  -> D7  (the Photon's small blue onboard LED is also on D7, so it will flicker; harmless)
//   15 LEDA -> VIN through a 22 ohm resistor (backlight +)
//   16 LEDK -> GND (backlight -)
//
// Refresh button: a momentary (normally open) push button between D1 and GND. D1 uses the
// Photon's internal pull-up, so no resistor is needed. Pressing it fetches the screen now.
//
// No libraries needed; the small HD44780 driver below is self-contained.

SYSTEM_THREAD(ENABLED);

constexpr pin_t LCD_RS = D2;
constexpr pin_t LCD_E  = D3;
constexpr pin_t LCD_DATA_PINS[4] = {D4, D5, D6, D7}; // DB4, DB5, DB6, DB7

// ---- Low-level HD44780 4-bit interface ------------------------------------------------------

void lcdPulseEnable() {
    digitalWrite(LCD_E, LOW);
    delayMicroseconds(1);
    digitalWrite(LCD_E, HIGH);
    delayMicroseconds(1);      // enable pulse width must be > 450 ns
    digitalWrite(LCD_E, LOW);
    delayMicroseconds(100);    // most commands need > 37 us to settle
}

void lcdWriteNibble(uint8_t nibble) {
    for (uint8_t i = 0; i < 4; ++i) {
        digitalWrite(LCD_DATA_PINS[i], (nibble >> i) & 0x01);
    }
    lcdPulseEnable();
}

void lcdWriteByte(uint8_t value, bool isData) {
    digitalWrite(LCD_RS, isData ? HIGH : LOW);
    lcdWriteNibble(value >> 4);   // high nibble first
    lcdWriteNibble(value & 0x0F);
}

void lcdCommand(uint8_t command) {
    lcdWriteByte(command, false);
}

// ---- Higher-level helpers ------------------------------------------------------------------

void lcdClear() {
    lcdCommand(0x01);
    delay(2);                     // clear needs ~1.52 ms
}

void lcdSetCursor(uint8_t column, uint8_t row) {
    static const uint8_t rowOffsets[2] = {0x00, 0x40};
    lcdCommand(0x80 | (column + rowOffsets[row & 0x01]));
}

// Stores a 5x8 custom character in one of the LCD's 8 CGRAM slots (0-7).
// Print it afterwards with lcdWriteByte(slot, true). Must be reloaded after every power-up.
void lcdCreateChar(uint8_t slot, const uint8_t rows[8]) {
    lcdCommand(0x40 | ((slot & 0x07) << 3)); // set CGRAM address
    for (uint8_t i = 0; i < 8; ++i) {
        lcdWriteByte(rows[i], true);
    }
    // The next lcdSetCursor() switches writes back to the display (DDRAM).
}

void lcdPrint(const char *text) {
    while (*text) {
        lcdWriteByte(static_cast<uint8_t>(*text++), true);
    }
}

void lcdBegin() {
    pinMode(LCD_RS, OUTPUT);
    pinMode(LCD_E, OUTPUT);
    for (pin_t pin : LCD_DATA_PINS) {
        pinMode(pin, OUTPUT);
    }
    digitalWrite(LCD_RS, LOW);
    digitalWrite(LCD_E, LOW);

    delay(50);                    // wait for LCD power-up (> 40 ms after VDD rises)

    // Datasheet "initialization by instruction" sequence to force 4-bit mode.
    lcdWriteNibble(0x03);
    delay(5);
    lcdWriteNibble(0x03);
    delayMicroseconds(150);
    lcdWriteNibble(0x03);
    delayMicroseconds(150);
    lcdWriteNibble(0x02);         // now in 4-bit mode

    lcdCommand(0x28);             // function set: 4-bit, 2 lines, 5x8 font
    lcdCommand(0x08);             // display off
    lcdClear();
    lcdCommand(0x06);             // entry mode: cursor moves right, no display shift
    lcdCommand(0x0C);             // display on, cursor off, blink off
}

// ---- Application ---------------------------------------------------------------------------

// Claude Code mascot, 5x8 dots (generated by icons/make_claude_glyph.py).
constexpr uint8_t CLAUDE_GLYPH_SLOT = 0;
constexpr uint8_t CLAUDE_GLYPH[8] = {0x00, 0x1F, 0x15, 0x1F, 0x1F, 0x1F, 0x15, 0x00};

// GitHub-style cat, 5x8 dots (same generator script).
constexpr uint8_t CAT_GLYPH_SLOT = 1;
constexpr uint8_t CAT_GLYPH[8] = {0x11, 0x1F, 0x15, 0x1F, 0x0E, 0x0F, 0x0A, 0x00};

// ElevenLabs (two bars in a box), 5x8 dots (same generator script).
constexpr uint8_t ELEVENLABS_GLYPH_SLOT = 2;
constexpr uint8_t ELEVENLABS_GLYPH[8] = {0x1F, 0x00, 0x0A, 0x0A, 0x0A, 0x00, 0x1F, 0x00};

// OpenAI logo (ring with gaps and a centre dot), 5x8 dots (same generator script).
constexpr uint8_t OPENAI_GLYPH_SLOT = 3;
constexpr uint8_t OPENAI_GLYPH[8] = {0x00, 0x0E, 0x1B, 0x15, 0x1B, 0x0E, 0x00, 0x00};

// Backslash for the spinner (the LCD font has a yen sign at the "\" code), same generator script.
constexpr uint8_t BACKSLASH_GLYPH_SLOT = 4;
constexpr uint8_t BACKSLASH_GLYPH[8] = {0x00, 0x10, 0x08, 0x04, 0x02, 0x01, 0x00, 0x00};

// Thumbs up, same generator script. Slot 5 is rewritten with this bitmap shifted down by 0-8
// rows to make it slide up and down inside its cell.
constexpr uint8_t THUMB_GLYPH_SLOT = 5;
constexpr uint8_t THUMB_GLYPH[8] = {0x04, 0x04, 0x0C, 0x1F, 0x1F, 0x1F, 0x1E, 0x00};

// ---- Refresh indicator (bottom-right cell) ---------------------------------------------------
// The Photon owns this one cell; the server leaves it blank.
//   refreshing: spinner \ | / -        error: "!" for 10 s, then blank
//   success:    thumbs up slides up, stays 3 s, slides back down, then blank

constexpr uint8_t INDICATOR_COL = 15;
constexpr uint8_t INDICATOR_ROW = 1;
constexpr unsigned long SPIN_FRAME_MS = 150;
constexpr unsigned long ERROR_HOLD_MS = 10000;
constexpr unsigned long THUMB_FRAME_MS = 50;  // per row of movement
constexpr unsigned long THUMB_HOLD_MS = 3000;
constexpr uint8_t SPINNER_FRAMES[4] = {BACKSLASH_GLYPH_SLOT, '|', '/', '-'};

enum class Indicator : uint8_t { IDLE, SPINNING, ERROR_HOLD, THUMB_UP, THUMB_HOLD, THUMB_DOWN };
Indicator indicator = Indicator::IDLE;
uint8_t indicatorStep = 0;           // spinner frame, or the thumb's downward shift (0 = fully up)
unsigned long indicatorNextAt = 0;

void drawIndicator(uint8_t code) {
    lcdSetCursor(INDICATOR_COL, INDICATOR_ROW);
    lcdWriteByte(code, true);
}

// Loads the thumb into its slot shifted down by `shift` rows (8 = empty). The cell updates at
// once because it already shows that slot.
void setThumbShift(uint8_t shift) {
    uint8_t rows[8];
    for (uint8_t r = 0; r < 8; ++r) {
        rows[r] = r >= shift ? THUMB_GLYPH[r - shift] : 0;
    }
    lcdCreateChar(THUMB_GLYPH_SLOT, rows);
}

void startSpinner() {
    indicator = Indicator::SPINNING;
    indicatorStep = 0;
    drawIndicator(SPINNER_FRAMES[0]);
    indicatorNextAt = millis() + SPIN_FRAME_MS;
}

void showError() {
    indicator = Indicator::ERROR_HOLD;
    drawIndicator('!');
    indicatorNextAt = millis() + ERROR_HOLD_MS;
}

void showSuccess() {
    indicator = Indicator::THUMB_UP;
    indicatorStep = 8;
    setThumbShift(8);                 // start empty, below the cell
    drawIndicator(THUMB_GLYPH_SLOT);
    indicatorNextAt = millis() + THUMB_FRAME_MS;
}

// Advances whatever animation is running. Cheap to call often.
void tickIndicator() {
    if (indicator == Indicator::IDLE || (long)(millis() - indicatorNextAt) < 0) {
        return;
    }
    switch (indicator) {
        case Indicator::SPINNING:
            indicatorStep = (indicatorStep + 1) % 4;
            drawIndicator(SPINNER_FRAMES[indicatorStep]);
            indicatorNextAt = millis() + SPIN_FRAME_MS;
            break;
        case Indicator::ERROR_HOLD:
            drawIndicator(' ');
            indicator = Indicator::IDLE;
            break;
        case Indicator::THUMB_UP:
            setThumbShift(--indicatorStep);
            if (indicatorStep == 0) {
                indicator = Indicator::THUMB_HOLD;
                indicatorNextAt = millis() + THUMB_HOLD_MS;
            } else {
                indicatorNextAt = millis() + THUMB_FRAME_MS;
            }
            break;
        case Indicator::THUMB_HOLD:
            indicator = Indicator::THUMB_DOWN;
            indicatorNextAt = millis() + THUMB_FRAME_MS;
            break;
        case Indicator::THUMB_DOWN:
            setThumbShift(++indicatorStep);
            if (indicatorStep >= 8) {
                drawIndicator(' ');
                indicator = Indicator::IDLE;
            } else {
                indicatorNextAt = millis() + THUMB_FRAME_MS;
            }
            break;
        default:
            break;
    }
}

// ---- Refresh button ----------------------------------------------------------------------------
// Active low: D1 reads HIGH through the internal pull-up and LOW while the button is held.

constexpr pin_t REFRESH_BUTTON = D1;
constexpr unsigned long DEBOUNCE_MS = 30;

bool buttonStableLevel = HIGH;
bool buttonLastReading = HIGH;
unsigned long buttonChangedAt = 0;

// Returns true once per press (on the debounced HIGH -> LOW edge).
bool refreshButtonPressed() {
    const bool reading = digitalRead(REFRESH_BUTTON);
    if (reading != buttonLastReading) {
        buttonLastReading = reading;
        buttonChangedAt = millis();
    }
    if (reading != buttonStableLevel && millis() - buttonChangedAt >= DEBOUNCE_MS) {
        buttonStableLevel = reading;
        return reading == LOW;
    }
    return false;
}

// ---- LCD server -------------------------------------------------------------------------------
// The LAN server (API/ in this repo) answers GET /lcd with exactly 32 raw bytes: the LCD's own
// character codes, line 1 then line 2. Custom glyph slot n appears at code 8 + n (the LCD mirrors
// codes 0-7 there), so the response never contains a 0 byte. The server holds every API key;
// nothing secret is stored in this firmware.

IPAddress LCD_SERVER(192, 168, 1, 220);
constexpr uint16_t LCD_PORT = 7007;
constexpr char LCD_PATH[] = "/lcd";
constexpr size_t SCREEN_BYTES = 32;
// How often to fetch comes from the server: each response carries "X-Refresh-Seconds: <n>" (the
// minutes asked when the server starts), which sets the wait before the next fetch. Until the
// first answer, or if a response lacks it, the last interval (5 minutes at boot) is kept.
constexpr unsigned long DEFAULT_REFRESH_MS = 300000; // 5 minutes
constexpr unsigned long MIN_REFRESH_MS = 60000;      // 1 minute
constexpr unsigned long MAX_REFRESH_MS = 86400000UL; // 1 day
constexpr unsigned long RETRY_MS = 30000;            // after a failure
constexpr unsigned long REQUEST_TIMEOUT_MS = 70000;  // the server may take a while asking 4 services
constexpr unsigned long STALE_AFTER_REFRESHES = 3;   // no good fetch for 3 intervals -> mark stale
constexpr char STALE_MARK = '!';                     // drawn in the last column of line 1

TCPClient client;
unsigned long refreshMs = DEFAULT_REFRESH_MS;
unsigned long nextFetchAt = 0;
unsigned long lastSuccessAt = 0;
bool haveScreen = false;
bool staleShown = false;

// (Pointer parameters, not uint8_t[SCREEN_BYTES]: Particle's auto-generated prototypes sit above
// the constants, so array sizes in signatures don't compile.)
void showScreen(const uint8_t *screen) {
    for (uint8_t row = 0; row < 2; ++row) {
        lcdSetCursor(0, row);
        for (uint8_t col = 0; col < 16; ++col) {
            lcdWriteByte(screen[row * 16 + col], true);
        }
    }
}

// ---- Number roll ------------------------------------------------------------------------------
// When a new screen arrives, each percentage that changed counts up or down from its old value to
// the new one (quick at first, settling at the end) instead of jumping. A percentage is 1-3 digits
// followed by '%'. It rolls only if the old screen had one starting at the same place after the
// same glyph (the nearest non-space to its left), so a meter that was "--", moved, or was swapped
// for another meter simply appears. The server left-aligns each value in a 4-character field, so
// the cells a roll draws in are its own.

constexpr unsigned long ROLL_MS = 1500;       // the whole roll, however far the number moves
constexpr unsigned long ROLL_FRAME_MS = 40;
constexpr uint8_t MAX_ROLLS = 8;
constexpr uint8_t MAX_PERCENT_CELLS = 4;      // "999%"

struct Roll {
    uint8_t start;   // screen index of the first digit
    uint8_t width;   // cells the number may cover: the longer of the old and new "N%"
    int from;
    int to;
    int shown;
};

Roll rolls[MAX_ROLLS];
uint8_t rollCount = 0;
unsigned long rollStartedAt = 0;
unsigned long rollNextAt = 0;
uint8_t lastScreen[SCREEN_BYTES];   // the screen the server last sent: where every roll ends up

// (Particle's generated prototypes sit above the Roll struct, so these functions take indexes and
// plain types, never a Roll.)

bool isDigitByte(uint8_t b) {
    return b >= '0' && b <= '9';
}

// Reads the percentage that starts exactly at `index`: 1-3 digits right after a non-digit, then
// '%', all on one line. Sets its value and its length including the '%'.
bool readPercent(const uint8_t *screen, uint8_t index, int *value, uint8_t *length) {
    const uint8_t lineStart = index < 16 ? 0 : 16;
    const uint8_t lineEnd = lineStart + 16;
    if (index > lineStart && isDigitByte(screen[index - 1])) {
        return false;
    }
    int v = 0;
    uint8_t i = index;
    while (i < lineEnd && i - index < 3 && isDigitByte(screen[i])) {
        v = v * 10 + (screen[i] - '0');
        ++i;
    }
    if (i == index || i >= lineEnd || screen[i] != '%') {
        return false;
    }
    *value = v;
    *length = i - index + 1;
    return true;
}

// The nearest non-space byte left of `index` on its line (the meter's glyph), or 0 if none.
uint8_t labelBefore(const uint8_t *screen, uint8_t index) {
    const uint8_t lineStart = index < 16 ? 0 : 16;
    for (uint8_t i = index; i > lineStart; --i) {
        if (screen[i - 1] != ' ') {
            return screen[i - 1];
        }
    }
    return 0;
}

// Writes "N%" left-aligned into `width` cells, padding with spaces.
void putPercent(uint8_t *cells, uint8_t width, int value) {
    char text[8];
    snprintf(text, sizeof(text), "%d%%", value);
    const size_t length = strlen(text);
    for (uint8_t i = 0; i < width; ++i) {
        cells[i] = i < length ? text[i] : ' ';
    }
}

void drawCells(uint8_t start, const uint8_t *cells, uint8_t count) {
    lcdSetCursor(start % 16, start / 16);
    for (uint8_t i = 0; i < count; ++i) {
        lcdWriteByte(cells[i], true);
    }
}

// Lands every running roll on its final value: the screen exactly as the server sent it.
void finishRolls() {
    for (uint8_t r = 0; r < rollCount; ++r) {
        drawCells(rolls[r].start, lastScreen + rolls[r].start, rolls[r].width);
    }
    rollCount = 0;
}

// Shows a freshly fetched screen, with every percentage that changed starting from its old value.
void showNewScreen(const uint8_t *screen) {
    finishRolls();
    uint8_t display[SCREEN_BYTES];
    memcpy(display, screen, SCREEN_BYTES);
    if (haveScreen) {
        for (uint8_t i = 0; i < SCREEN_BYTES && rollCount < MAX_ROLLS; ++i) {
            int from = 0;
            int to = 0;
            uint8_t oldLength = 0;
            uint8_t newLength = 0;
            if (!readPercent(lastScreen, i, &from, &oldLength) || !readPercent(screen, i, &to, &newLength) ||
                from == to || labelBefore(lastScreen, i) != labelBefore(screen, i)) {
                continue;
            }
            Roll &roll = rolls[rollCount++];
            roll.start = i;
            roll.width = oldLength > newLength ? oldLength : newLength;
            roll.from = from;
            roll.to = to;
            roll.shown = from;
            putPercent(display + i, roll.width, from);
        }
    }
    memcpy(lastScreen, screen, SCREEN_BYTES);
    showScreen(display);
    rollStartedAt = millis();
    rollNextAt = rollStartedAt + ROLL_FRAME_MS;
}

// Advances the rolls. Cheap to call often.
void tickRolls() {
    if (rollCount == 0 || (long)(millis() - rollNextAt) < 0) {
        return;
    }
    const unsigned long elapsed = millis() - rollStartedAt;
    if (elapsed >= ROLL_MS) {
        finishRolls();
        return;
    }
    const float t = (float)elapsed / ROLL_MS;
    const float eased = 1.0f - (1.0f - t) * (1.0f - t) * (1.0f - t); // ease-out cubic
    for (uint8_t r = 0; r < rollCount; ++r) {
        Roll &roll = rolls[r];
        const float step = (roll.to - roll.from) * eased;
        const int value = roll.from + (int)(step >= 0 ? step + 0.5f : step - 0.5f); // nearest
        if (value != roll.shown) {
            roll.shown = value;
            uint8_t cells[MAX_PERCENT_CELLS];
            putPercent(cells, roll.width, value);
            drawCells(roll.start, cells, roll.width);
        }
    }
    rollNextAt = millis() + ROLL_FRAME_MS;
}

uint8_t lowerByte(uint8_t b) {
    return (b >= 'A' && b <= 'Z') ? b + ('a' - 'A') : b;
}

// The number in an "X-Refresh-Seconds: <n>" header among the first `headerLength` bytes of the
// response (header names ignore case), or 0 if there is none.
unsigned long readRefreshSeconds(const uint8_t *response, size_t headerLength) {
    static const char NAME[] = "\r\nx-refresh-seconds:";
    const size_t nameLength = sizeof(NAME) - 1;
    for (size_t i = 0; i + nameLength <= headerLength; ++i) {
        size_t matched = 0;
        while (matched < nameLength && lowerByte(response[i + matched]) == (uint8_t)NAME[matched]) {
            ++matched;
        }
        if (matched < nameLength) {
            continue;
        }
        size_t k = i + nameLength;
        while (k < headerLength && response[k] == ' ') {
            ++k;
        }
        unsigned long seconds = 0;
        while (k < headerLength && isDigitByte(response[k]) && seconds < 1000000UL) {
            seconds = seconds * 10 + (response[k] - '0');
            ++k;
        }
        return seconds;
    }
    return 0;
}

// Blocking HTTP/1.0 GET of /lcd. Returns true only for a 200 with exactly 32 body bytes, and sets
// *refreshSeconds from the X-Refresh-Seconds header (0 if it's missing).
bool fetchScreen(uint8_t *screen, unsigned long *refreshSeconds) {
    if (!client.connect(LCD_SERVER, LCD_PORT)) {
        return false;
    }
    client.printf("GET %s HTTP/1.0\r\nHost: %d.%d.%d.%d\r\nConnection: close\r\n\r\n",
                  LCD_PATH, LCD_SERVER[0], LCD_SERVER[1], LCD_SERVER[2], LCD_SERVER[3]);

    uint8_t response[512];
    size_t length = 0;
    const unsigned long startedAt = millis();
    while ((client.connected() || client.available()) && millis() - startedAt < REQUEST_TIMEOUT_MS) {
        while (client.available() && length < sizeof(response)) {
            response[length++] = client.read();
        }
        tickIndicator(); // keep the spinner turning while the server works
        Particle.process();
    }
    client.stop();

    // Status line must be "HTTP/1.x 200 ...".
    if (length < 12 || memcmp(response, "HTTP/1.", 7) != 0 || memcmp(response + 8, " 200", 4) != 0) {
        return false;
    }
    // Body starts after the blank line; it is binary, so search byte by byte.
    for (size_t i = 0; i + 3 < length; ++i) {
        if (memcmp(response + i, "\r\n\r\n", 4) == 0) {
            const size_t bodyStart = i + 4;
            if (length - bodyStart != SCREEN_BYTES) {
                return false; // wrong size: keep the last good screen rather than scramble it
            }
            memcpy(screen, response + bodyStart, SCREEN_BYTES);
            *refreshSeconds = readRefreshSeconds(response, i + 2); // headers incl. the last "\r\n"
            return true;
        }
    }
    return false;
}

void setup() {
    pinMode(REFRESH_BUTTON, INPUT_PULLUP);
    lcdBegin();
    lcdCreateChar(CLAUDE_GLYPH_SLOT, CLAUDE_GLYPH);
    lcdCreateChar(CAT_GLYPH_SLOT, CAT_GLYPH);
    lcdCreateChar(ELEVENLABS_GLYPH_SLOT, ELEVENLABS_GLYPH);
    lcdCreateChar(OPENAI_GLYPH_SLOT, OPENAI_GLYPH);
    lcdCreateChar(BACKSLASH_GLYPH_SLOT, BACKSLASH_GLYPH);
    setThumbShift(8);

    lcdSetCursor(0, 0);
    lcdPrint("Connecting...");
}

void loop() {
    tickIndicator();
    tickRolls();

    // A button press makes the next fetch due now. (Presses while a fetch is running are not
    // seen, since fetchScreen() blocks; the screen is about to be fresh anyway.)
    if (refreshButtonPressed()) {
        nextFetchAt = millis();
    }

    // Mark the screen stale (once) if the last good fetch is too old.
    if (haveScreen && !staleShown && millis() - lastSuccessAt > STALE_AFTER_REFRESHES * refreshMs) {
        lcdSetCursor(15, 0);
        lcdWriteByte(STALE_MARK, true);
        staleShown = true;
    }

    if (!WiFi.ready() || (long)(millis() - nextFetchAt) < 0) {
        return;
    }

    finishRolls();                    // the fetch blocks; don't leave a number frozen mid-roll
    startSpinner();
    uint8_t screen[SCREEN_BYTES];
    unsigned long refreshSeconds = 0;
    if (fetchScreen(screen, &refreshSeconds)) {
        if (refreshSeconds > 0) {
            const unsigned long ms = refreshSeconds * 1000UL; // at most 1e9: fits
            refreshMs = ms < MIN_REFRESH_MS ? MIN_REFRESH_MS : (ms > MAX_REFRESH_MS ? MAX_REFRESH_MS : ms);
        }
        showNewScreen(screen);        // overwrites the indicator cell with the server's blank
        showSuccess();
        haveScreen = true;
        staleShown = false;
        lastSuccessAt = millis();
        nextFetchAt = millis() + refreshMs;
    } else {
        showError();
        nextFetchAt = millis() + RETRY_MS; // keep the last good screen
    }
}
